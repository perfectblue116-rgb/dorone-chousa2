<script>
const T={uki:{n:'タイル浮き',c:'#e03131'},ware:{n:'タイル割れ',c:'#e8590c'},efl:{n:'エフロ(白華)',c:'#7048e8'},caulk:{n:'コーキング劣化',c:'#1c7ed6'},imp:{n:'取込図形',c:'#6b6b6b'},hage:{n:'防水シート剥れ',c:'#2f9e44'},sUki:{n:'防水シート浮き',c:'#d4a017'}};
const TL=[['select','↖','選択'],['marq','⬚','範囲選択'],['rect','▭','四角'],['ellipse','◯','丸'],['poly','⬠','ポリゴン'],['pen','✎','ペン'],['line','╱','線'],['del','🗑','削除']];
const DS={fill:true,fo:.2,stroke:true,so:1,sw:4,dash:false};
let files=[],fi=0,imported=new Set(),doc=null,pgs=[],page=1,total=0,zoom=1,tool='select',type='uki',anns=[],sels=new Set(),mq=null,cur=null,tab=0,uid=1,drag=null,gen=0,io=null,impN=0,tk=0;
const $=id=>document.getElementById(id),PG=$('pages'),ST=$('stage');
$('tools').innerHTML=TL.map(t=>`<button data-k="${t[0]}"><span>${t[1]}</span>${t[2]}</button>`).join('');
$('tools').onclick=e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.k==='del'){del();return}tool=b.dataset.k;cur=null;mq=null;tools();drawAll()};
function tools(){document.querySelectorAll('#tools button').forEach(b=>b.classList.toggle('on',b.dataset.k===tool));PG.classList.toggle('dw',tool!=='select')}
document.querySelectorAll('.tabs div').forEach(d=>d.onclick=()=>{tab=+d.dataset.t;document.querySelectorAll('.tabs div').forEach(x=>x.classList.toggle('on',x===d));panel()});

/* ---- ファイル読込 ---- */
$('file').onchange=async e=>{const first=files.length;
 for(const f of e.target.files){const o={name:f.name};
  if(f.type==='application/pdf'||/\.pdf$/i.test(f.name)){o.doc=await pdfjsLib.getDocument({data:await f.arrayBuffer()}).promise;o.total=o.doc.numPages}
  else{o.img=await new Promise(r=>{const i=new Image();i.onload=()=>r(i);i.src=URL.createObjectURL(f)});o.total=1}
  files.push(o)}
 e.target.value='';if(files.length>first)await sw(first,1)};
$('fs').onchange=e=>sw(+e.target.value,1);
async function sw(i,pg){fi=i;const o=files[i];doc=o.doc;total=o.total;const my=++gen;if(io)io.disconnect();PG.innerHTML='';pgs=[];sels=new Set();cur=null;mq=null;
 $('fs').innerHTML=files.map((f,k)=>`<option value="${k}">${f.name.replace(/</g,'')}</option>`).join('');$('fs').value=i;$('empty').style.display='none';
 io=new IntersectionObserver(es=>es.forEach(en=>{const k=+en.target.dataset.i,g=pgs[k];if(!g)return;g.vis=en.isIntersecting;if(g.vis)render(k);else if(g.rendered&&!g.busy)release(g)}),{root:ST,rootMargin:'1500px 0px'});
 for(let k=0;k<total;k++){const el=document.createElement('div');el.className='sheet';el.dataset.i=k;el.innerHTML='<canvas></canvas><svg></svg><b class="no">'+(k+1)+'</b>';PG.appendChild(el);
  pgs.push({el,cv:el.children[0],svg:el.children[1],d:doc,img:o.img||null,rendered:false,busy:false,vis:false});io.observe(el)}
 $('pt').textContent=total;await prep(0);fit();toPage(pg);tools();panel();bg(my)}
async function prep(i){const g=pgs[i];if(!g||g.v)return;
 if(g.img){g.W=g.img.naturalWidth;g.H=g.img.naturalHeight;g.v=true}
 else{g.p=await g.d.getPage(i+1);const v1=g.p.getViewport({scale:1}),s=Math.min(2,2400/v1.width);g.v=g.p.getViewport({scale:s});g.W=g.v.width;g.H=g.v.height}
 g.svg.setAttribute('viewBox',`0 0 ${g.W} ${g.H}`);sz(g)}
function sz(g){const b=pgs[0]||{},W=g.W||b.W||1000,H=g.H||b.H||1414;g.el.style.width=W*zoom+'px';g.el.style.height=H*zoom+'px'}
function setZ(){const r=ST.scrollTop/(ST.scrollHeight||1);pgs.forEach(sz);ST.scrollTop=r*ST.scrollHeight;drawAll()}
function fit(){zoom=(ST.clientWidth-40)/((pgs[0]&&pgs[0].W)||1000);setZ()}
$('zi').onclick=()=>{zoom*=1.2;setZ()};$('zo').onclick=()=>{zoom/=1.2;setZ()};$('zf').onclick=fit;
/* Ctrl+ホイール(トラックパッドのピンチ含む)=図面表示部分のみ拡大縮小。操作パネルはブラウザ拡大も含め固定 */
let wz=null;
addEventListener('wheel',e=>{if(!e.ctrlKey)return;e.preventDefault();
 if(!ST.contains(e.target)||!pgs.length)return;
 const d=e.deltaY*(e.deltaMode===1?16:e.deltaMode===2?400:1),f=Math.exp(-Math.max(-300,Math.min(300,d))*.0015);
 if(!wz){const sh=e.target.closest&&e.target.closest('.sheet'),r=sh?sh.getBoundingClientRect():null;
  wz={f:1,mx:e.clientX,my:e.clientY,sh,fx:r?(e.clientX-r.left)/r.width:0,fy:r?(e.clientY-r.top)/r.height:0};
  requestAnimationFrame(()=>{const w=wz;wz=null;const nz=Math.min(8,Math.max(.1,zoom*w.f));if(nz===zoom)return;zoom=nz;pgs.forEach(sz);drawAll();
   if(w.sh){const r=w.sh.getBoundingClientRect();ST.scrollLeft+=r.left+w.fx*r.width-w.mx;ST.scrollTop+=r.top+w.fy*r.height-w.my}})}
 wz.f*=f},{passive:false});
async function render(i){const g=pgs[i];if(!g||g.busy||g.rendered)return;g.busy=true;const my=gen;
 try{await prep(i);if(my!==gen)return;g.cv.width=g.W;g.cv.height=g.H;const x=g.cv.getContext('2d');
  if(g.img)x.drawImage(g.img,0,0);else await g.p.render({canvasContext:x,viewport:g.v,annotationMode:$('imp').checked?0:1}).promise;
  g.rendered=true}catch(e){console.error(e)}finally{g.busy=false}
 if(!g.vis&&g.rendered)release(g)}
function release(g){g.cv.width=g.cv.height=1;g.rendered=false}
$('imp').onchange=()=>{pgs.forEach((g,i)=>{if(g.rendered&&!g.busy)release(g);if(g.vis)render(i)});bg(gen)};
async function bg(my){for(let i=0;i<pgs.length&&my===gen;i++){await prep(i);if(my!==gen)return;impPage(i)}if(my===gen)panel()}
function impPage(i){const g=pgs[i];const key=fi+':'+(i+1);if(!g||g.img||!$('imp').checked||imported.has(key))return;imported.add(key);
 return g.p.getAnnotations({intent:'display'}).then(L=>{const X=(x,y)=>g.v.convertToViewportPoint(x,y),page=i+1;
 const rgb=c=>c&&c.length>=3?'#'+[0,1,2].map(k=>(c[k]|0).toString(16).padStart(2,'0')).join(''):null;
 const add=(shape,pts,n,o={})=>{const sc=rgb(n.color),ic=rgb(n.interiorColor||n.backgroundColor||n.fillColor),closed=shape!=='line'&&shape!=='pen';
  const op=[n.opacity,n.CA,n.fillOpacity].find(v=>typeof v==='number'),bs=n.borderStyle||{},w=bs.width!=null?bs.width:n.borderWidth;
  const s=Object.assign({stroke:n.color!==null&&!(w===0),sc:sc||'#e03131',so:op!=null?op:1,fill:closed&&!!ic,fc:ic||sc||'#e03131',fo:op!=null?op:1,sw:w>0?Math.max(.5,w*g.v.scale):3,dash:bs.style===2},o.s||{});
  const a={id:uid++,page,f:fi,type:'imp',shape,pts,s,memo:(n.contentsObj&&n.contentsObj.str)||n.contents||''};if(o.showText)a.showText=true;anns.push(a);impN++};
 for(const n of L){const r=n.rect,t=n.subtype;
  if(t==='Square'||t==='Circle')add(t==='Circle'?'ellipse':'rect',[X(r[0],r[1]),X(r[2],r[3])],n);
  else if(t==='Highlight')add('rect',[X(r[0],r[1]),X(r[2],r[3])],n,{s:{fill:true,fc:rgb(n.color)||'#ffe94d',stroke:false,fo:typeof n.opacity==='number'?n.opacity:.4}});
  else if(t==='FreeText')add('rect',[X(r[0],r[1]),X(r[2],r[3])],n,{showText:true,s:{stroke:false,sc:'#000'}});
  else if(t==='Line'&&n.lineCoordinates){const q=n.lineCoordinates;add('line',[X(q[0],q[1]),X(q[2],q[3])],n)}
  else if((t==='Polygon'||t==='PolyLine')&&n.vertices){let q=n.vertices;if(typeof q[0]==='number')q=q.reduce((a,x,k)=>k%2?(a[a.length-1].y=x,a):a.concat({x}),[]);add(t==='Polygon'?'poly':'line',q.map(o=>X(o.x,o.y)),n)}
  else if(t==='Ink'&&n.inkLists)n.inkLists.forEach(l=>add('pen',l.map(o=>X(o.x,o.y)),n))}
 $('msg').textContent=impN?`PDF注釈 ${impN}件を編集可能に変換`:'';draw(i)})}

/* ---- ページ移動 ---- */
function toPage(n){n=Math.min(total,Math.max(1,n));const g=pgs[n-1];if(g)ST.scrollTo({top:g.el.offsetTop-10})}
$('prev').onclick=()=>toPage(page-1);$('next').onclick=()=>toPage(page+1);$('pn').onchange=e=>toPage(+e.target.value);
ST.addEventListener('scroll',()=>{if(tk)return;tk=requestAnimationFrame(()=>{tk=0;const y=ST.scrollTop+ST.clientHeight*.35;let k=0;
 while(k<pgs.length-1&&pgs[k].el.offsetTop+pgs[k].el.offsetHeight<y)k++;page=k+1;if(document.activeElement!==$('pn'))$('pn').value=page})});
function focusAnn(a){const g=pgs[a.page-1];if(!g)return;const y=Math.min(...a.pts.map(q=>q[1]));ST.scrollTo({top:g.el.offsetTop+y*zoom-120})}

/* ---- 描画 ---- */
function label(a){if(a.shape==='legend')return'凡例';const l=anns.filter(x=>x.type===a.type);return T[a.type].n+'-'+(l.indexOf(a)+1)}
function st(a){const c=a.color||TT(a.type).c;return Object.assign({},DS,{sc:c,fc:c},a.s||{})}
function showT(a){return a.showText!==undefined?a.showText:!(a.type==='imp'||a.type==='uki')}
function shape(a,live,W){if(a.shape==='legend')return legSvg(a,sels.has(a.id)&&!live,W);const S=st(a),p=a.pts,sl=sels.has(a.id)&&!live,open=a.shape==='line'||a.shape==='pen',fs=W/180;let lp=p[0],g;
 if(a.shape==='rect'){const x=Math.min(p[0][0],p[1][0]),y=Math.min(p[0][1],p[1][1]),w=Math.abs(p[1][0]-p[0][0]),h=Math.abs(p[1][1]-p[0][1]);lp=[x,y];g=at=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" ${at}/>`}
 else if(a.shape==='ellipse'){lp=[Math.min(p[0][0],p[1][0]),Math.min(p[0][1],p[1][1])];g=at=>`<ellipse cx="${(p[0][0]+p[1][0])/2}" cy="${(p[0][1]+p[1][1])/2}" rx="${Math.abs(p[1][0]-p[0][0])/2}" ry="${Math.abs(p[1][1]-p[0][1])/2}" ${at}/>`}
 else if(a.shape==='poly')g=at=>`<polygon points="${p.join(' ')}" ${at}/>`;
 else g=at=>`<polyline points="${p.join(' ')}" ${at}/>`;
 const fl=(open||!S.fill)?'fill="none"':`fill="${S.fc}" fill-opacity="${S.fo}"`;
 const sk=S.stroke?`stroke="${S.sc}" stroke-opacity="${S.so}" stroke-width="${S.sw}"`+(S.dash?` stroke-dasharray="${S.sw*3} ${S.sw*2}"`:''):'stroke="none"';
 let el=(sl?g(`fill="none" stroke="#1e90ff" stroke-opacity=".6" stroke-width="${S.sw*zoom+5}" vector-effect="non-scaling-stroke" style="pointer-events:none"`):'')+(open?g(`fill="none" stroke="transparent" stroke-width="${Math.max(S.sw,14/zoom)}" pointer-events="stroke" data-id="${a.id}" stroke-linecap="round" stroke-linejoin="round" style="cursor:move"`):'')+g(`${open?'':'pointer-events="all" '}data-id="${a.id}" stroke-linecap="round" stroke-linejoin="round" style="cursor:move" ${fl} ${sk}`);
 const txt=a.type==='imp'?(a.memo||''):label(a)+(a.memo?'：'+a.memo:'');
 if(!live&&showT(a)&&txt){const o=a.to||[0,0];el+=`<text x="${lp[0]+o[0]}" y="${lp[1]-fs*.4+o[1]}" font-size="${fs}" font-weight="700" fill="${S.sc}" stroke="#fff" stroke-width="2" paint-order="stroke" ${tool!=='marq'?`data-id="${a.id}" data-t="1" style="pointer-events:all;cursor:move;user-select:none"`:'style="pointer-events:none"'}>${txt.replace(/[<&]/g,'')}</text>`}
 if(sl&&sels.size===1&&a.shape!=='pen')el+=a.pts.slice(0,60).map((q,i)=>`<circle cx="${q[0]}" cy="${q[1]}" r="${W/880}" fill="#fff" stroke="#1e90ff" stroke-width="1" vector-effect="non-scaling-stroke" data-id="${a.id}" data-h="${i}" style="cursor:move"/>`).join('');
 return el}
function draw(i){const g=pgs[i];if(!g)return;const W=g.W||1000;g.svg.innerHTML=anns.filter(a=>a.f===fi&&a.page===i+1).map(a=>shape(a,0,W)).join('')+(cur&&cur.pi===i?shape(cur,1,W):'')+(mq&&mq.i===i?mqSvg():'')}
/* ---- 凡例・防水種別 ---- */
const TT=k=>T[k]||{n:'凡例',c:'#666'};
const WPS=['防水シート','ゴムシート防水','ウレタン防水'];let wp='防水シート';
function applyWp(v){wp=v;T.hage.n=v+'剥れ';T.sUki.n=v+'浮き';anns.forEach(a=>{if(a.shape==='legend')legFix(a)})}
function setWp(v){applyWp(v);drawAll();panel()}
const LG=[['uki','ware','efl'],['caulk','hage','sUki']],LFS=44,LSQ=52,LFONT='Hiragino Sans,Noto Sans JP,Yu Gothic,Meiryo,sans-serif';
function tw(t){let w=0;for(const c of t)w+=c.charCodeAt(0)<256?.55:1;return w*LFS}
function legL(){const l=Math.max(...LG[0].map(k=>tw(T[k].n))),r=Math.max(...LG[1].map(k=>tw(T[k].n))),x2=25+LSQ+33+l+70;return{DW:Math.round(x2+LSQ+33+r+25),DH:240,x2}}
function legFix(a){const L=legL();a.pts[1]=[a.pts[0][0]+a.lw,a.pts[0][1]+a.lw*L.DH/L.DW]}
function legSvg(a,sl,W){const L=legL(),x=a.pts[0][0],y=a.pts[0][1],k=a.lw/L.DW,h=a.lw*L.DH/L.DW,bg=a.bg!==false;
