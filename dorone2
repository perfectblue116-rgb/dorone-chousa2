let pmode='print';
$('prt').onclick=()=>openDlg('print');$('pdfb').onclick=()=>openDlg('pdf');
function openDlg(m){if(!pgs.length){alert('図面を開いてください');return}pmode=m;const t=m==='pdf'?'PDF保存':'印刷';$('pdt').textContent=t;$('po').textContent=t;$('prow').style.display=m==='pdf'?'none':'';$('pdn').textContent=total;$('pd').showModal()}
addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='p'){e.preventDefault();openDlg('print')}});
$('pc').onclick=()=>$('pd').close();
$('po').onclick=()=>{$('pd').close();const all=document.querySelector('input[name=pr]:checked').value==='all';const idx=all?pgs.map((_,i)=>i):[page-1];if(pmode==='pdf')doPdf(idx);else doPrint(idx,$('psz').value)};
async function pageBlob(i){const g=pgs[i],c=document.createElement('canvas');c.width=g.W;c.height=g.H;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,g.W,g.H);
 if(g.img)x.drawImage(g.img,0,0);else await g.p.render({canvasContext:x,viewport:g.v,annotationMode:$('imp').checked?0:1}).promise;
 const sv=sels;sels=new Set();const inner=anns.filter(a=>a.f===fi&&a.page===i+1).map(a=>shape(a,0,g.W)).join('');sels=sv;
 const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${g.W}" height="${g.H}" viewBox="0 0 ${g.W} ${g.H}" font-family="Hiragino Sans,Noto Sans JP,Yu Gothic,Meiryo,sans-serif">${inner}</svg>`;
 const im=await new Promise((res,rej)=>{const t=new Image();t.onload=()=>res(t);t.onerror=rej;t.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg)});
 x.drawImage(im,0,0,g.W,g.H);return await new Promise(r=>c.toBlob(r,'image/jpeg',.95))}
async function pageUrl(i){return URL.createObjectURL(await pageBlob(i))}
let pUrls=[];
function pClean(){$('printArea').innerHTML='';document.documentElement.classList.remove('pr');document.body.classList.remove('pr');pUrls.forEach(u=>URL.revokeObjectURL(u));pUrls=[];$('msg').textContent=''}
async function doPrint(idx,sz){pClean();const my=gen,[w,h]=sz==='A3'?[297,420]:[210,297],m=8;let html='';
 try{for(let k=0;k<idx.length;k++){const i=idx[k];$('msg').textContent=`印刷準備中 ${k+1}/${idx.length}`;await prep(i);await impPage(i);if(my!==gen)return pClean();
   const g=pgs[i],u=await pageUrl(i),land=g.W>g.H,aw=land?h-2*m:w-2*m,ah=(land?w:h)-2*m-1;pUrls.push(u);
   html+=`<div class="pf ${land?'pl':'pp'}"><img src="${u}" style="${g.W/g.H>aw/ah?'width:100%;height:auto':`height:${ah}mm;width:auto`}"></div>`}}
 catch(err){console.error(err);pClean();alert('印刷の準備に失敗しました');return}
 $('printArea').innerHTML=`<style>@page pp{size:${w}mm ${h}mm;margin:${m}mm}@page pl{size:${h}mm ${w}mm;margin:${m}mm}.pp{page:pp}.pl{page:pl}.pf{break-after:page}.pf:last-child{break-after:auto}.pf img{display:block;margin:0 auto}</style>`+html;
 await Promise.all([...$('printArea').querySelectorAll('img')].map(im=>im.decode().catch(()=>{})));
 document.documentElement.classList.add('pr');document.body.classList.add('pr');$('msg').textContent='';
 addEventListener('afterprint',pClean,{once:true});window.print()}
/* ---- PDF保存(記入入りの図面を1ページ1枚のPDFに書き出し) ---- */
function makePdf(P){const enc=new TextEncoder(),ch=[],off=[];let len=0;
 const put=x=>{const b=typeof x==='string'?enc.encode(x):x;ch.push(b);len+=b.length},N=2+3*P.length;
 put('%PDF-1.4\n%\u00e2\u00e3\u00cf\u00d3\n');
 off[1]=len;put('1 0 obj\n<</Type/Catalog/Pages 2 0 R>>\nendobj\n');
 off[2]=len;put(`2 0 obj\n<</Type/Pages/Count ${P.length}/Kids[${P.map((_,k)=>(3+3*k)+' 0 R').join(' ')}]>>\nendobj\n`);
 P.forEach((g,k)=>{const o=3+3*k,pw=g.pw.toFixed(2),ph=g.ph.toFixed(2),c=`q ${pw} 0 0 ${ph} 0 0 cm /Im0 Do Q`;
  off[o]=len;put(`${o} 0 obj\n<</Type/Page/Parent 2 0 R/MediaBox[0 0 ${pw} ${ph}]/Resources<</XObject<</Im0 ${o+2} 0 R>>>>/Contents ${o+1} 0 R>>\nendobj\n`);
  off[o+1]=len;put(`${o+1} 0 obj\n<</Length ${c.length}>>\nstream\n${c}\nendstream\nendobj\n`);
  off[o+2]=len;put(`${o+2} 0 obj\n<</Type/XObject/Subtype/Image/Width ${g.w}/Height ${g.h}/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/DCTDecode/Length ${g.jpg.length}>>\nstream\n`);put(g.jpg);put('\nendstream\nendobj\n')});
 const xp=len;let x=`xref\n0 ${N+1}\n0000000000 65535 f \n`;for(let i=1;i<=N;i++)x+=String(off[i]).padStart(10,'0')+' 00000 n \n';
 put(x+`trailer\n<</Size ${N+1}/Root 1 0 R>>\nstartxref\n${xp}\n%%EOF\n`);return new Blob(ch,{type:'application/pdf'})}
async function doPdf(idx){const my=gen,P=[];
 try{for(let k=0;k<idx.length;k++){const i=idx[k];$('msg').textContent=`PDF作成中 ${k+1}/${idx.length}`;await prep(i);await impPage(i);if(my!==gen){$('msg').textContent='';return}
   const g=pgs[i],bl=await pageBlob(i);P.push({w:g.W,h:g.H,pw:g.p?g.W/g.v.scale:g.W*.75,ph:g.p?g.H/g.v.scale:g.H*.75,jpg:new Uint8Array(await bl.arrayBuffer())})}}
 catch(err){console.error(err);$('msg').textContent='';alert('PDFの作成に失敗しました');return}
 const u=URL.createObjectURL(makePdf(P));dl(u,(files[fi]?files[fi].name.replace(/\.[^.]+$/,''):'図面')+'_記入.pdf');setTimeout(()=>URL.revokeObjectURL(u),10000);$('msg').textContent=''}
function dl(u,n){const a=document.createElement('a');a.href=u;a.download=n;a.click()}
tools();panel();
</script></body></html>
