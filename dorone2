.sheet svg{touch-action:pan-x pan-y pinch-zoom}.sheet,svg,canvas{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent}#pages.dw,#pages.dw .sheet,#pages.dw svg,#pages.dw svg *,#pages.dw canvas{touch-action:none}
